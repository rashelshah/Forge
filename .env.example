# Everything is optional. With no keys, Foundry runs fully offline in demo mode:
# local JSON database, no auth, local vector file, template agents.

# --- Supabase (database + auth + pgvector). Run supabase/migrations/001_init.sql then 002_pgvector.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI layer
# Free LLM: create a key at https://console.groq.com/keys (no card needed)
GROQ_API_KEY=
# Optional overrides. Heavy model (validation, chair, MVP) and a comma list of fast models (boardroom turns).
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Free tier: 1,000 searches/month
TAVILY_API_KEY=
# Not needed: competitor pages are fetched directly, falling back to Tavily Extract for bot-protected sites.
FIRECRAWL_API_KEY=
# Vector search uses Supabase pgvector (run supabase/migrations/002_pgvector.sql). Embeddings are computed
# locally with bge-small-en-v1.5 (free) — Groq doesn't offer embedding models.

# --- Design Intelligence Knowledge Base (admin page). Run supabase/migrations/004_design_references.sql and
# `ai/.venv/bin/playwright install chromium`. Screenshots are analysed by a vision model (Gemini, or OpenAI gpt-4o-mini).
# Comma-separated emails allowed to use it.
ADMIN_EMAILS=
# Qdrant server or cloud. Leave empty to use an embedded on-disk store in ai/.qdrant.
QDRANT_URL=
QDRANT_API_KEY=

# --- Service wiring
AI_URL=http://localhost:8000
# Shared secret between the Node API and the Python agent service (recommended in production)
AI_INTERNAL_KEY=
API_PORT=4000
FRONTEND_URL=http://localhost:5173
# Set when the frontend is deployed separately from the API
VITE_API_URL=
